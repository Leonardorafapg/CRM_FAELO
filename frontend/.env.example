# URL do gateway (nao do platform-service direto).
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL do whatsapp-service pra conexao WebSocket direta — o gateway e um
# proxy HTTP puro (httpx) e nao sabe fazer upgrade de WebSocket, entao o
# frontend conecta direto no servico, sem passar pelo gateway.
# Em dev local o fallback em lib/whatsapp.ts (troca ":8000" por ":8003" na
# API_URL) cobre isso sozinho. Em producao (Railway ou qualquer host onde a
# URL do gateway nao termina em ":8000") o fallback NAO bate em nada e o
# WebSocket tenta conectar no proprio gateway por engano (dá 403) — defina
# esta variavel explicitamente nesse caso.
NEXT_PUBLIC_WHATSAPP_WS_URL=ws://localhost:8003

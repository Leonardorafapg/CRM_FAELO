# Banco proprio do ai-service (schema/DB dedicado) — so guarda FaqItem,
# nunca identidade/config do tenant (isso mora no platform-service).
DATABASE_URL=postgresql://user:pass@localhost:5432/ai_service

# Mesmo valor do platform-service — ai-service so VERIFICA o JWT emitido
# por ele, nunca emite token proprio.
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-longo
JWT_ALGORITHM=HS256

# Chamada interna a GET /internal/tenants/{id} do platform-service (busca
# system_prompt, ai_provider, ai_api_key, business_hours, etc. pra montar o
# prompt) — mesmo valor configurado la.
PLATFORM_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_KEY=troque-por-um-valor-aleatorio-longo

ALLOWED_ORIGINS=http://localhost:3000

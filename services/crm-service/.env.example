# Banco proprio do crm-service (schema/DB dedicado)
DATABASE_URL=postgresql://user:pass@localhost:5432/crm_service

# Mesmo valor do platform-service — crm-service so VERIFICA o JWT emitido
# por ele, nunca emite token proprio.
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-longo
JWT_ALGORITHM=HS256

# So necessario se/quando este servico chamar outro internamente.
INTERNAL_SERVICE_KEY=troque-por-um-valor-aleatorio-longo

ALLOWED_ORIGINS=http://localhost:3000

# URLs internas dos servicos que o gateway distribui — em dev sao portas
# locais; em producao, seriam hostnames internos (ex.: http://platform-service:8001
# dentro de uma rede docker/kubernetes, nunca expostos publicamente).
PLATFORM_SERVICE_URL=http://localhost:8001
CRM_SERVICE_URL=http://localhost:8002
CONVERSATION_SERVICE_URL=http://localhost:8003

# Quem pode chamar o gateway a partir do browser (o frontend).
ALLOWED_ORIGINS=http://localhost:3000

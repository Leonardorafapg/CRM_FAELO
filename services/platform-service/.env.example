# Banco proprio do platform-service (schema/DB dedicado)
DATABASE_URL=postgresql://user:pass@localhost:5432/platform_service

# Compartilhado com crm-service e conversation-service — so o platform-service
# EMITE tokens, os outros so verificam.
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-longo
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Compartilhado entre os 3 servicos — chamadas internas servico-a-servico.
INTERNAL_SERVICE_KEY=troque-por-um-valor-aleatorio-longo

ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Opcional — sem isso, emails de reset/convite so logam erro e nao enviam.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Banco proprio do whatsapp-service (schema/DB dedicado)
DATABASE_URL=postgresql://user:pass@localhost:5432/whatsapp_service

# Mesmo valor do platform-service — whatsapp-service so VERIFICA o JWT
# emitido por ele, nunca emite token proprio.
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-longo
JWT_ALGORITHM=HS256

# Usada pra chamar POST /internal/ai/respond do ai-service (resposta
# automatica a mensagem de cliente) — mesmo valor configurado la.
INTERNAL_SERVICE_KEY=troque-por-um-valor-aleatorio-longo

# Chamada interna a POST /internal/ai/respond do ai-service. Se nao
# configurado, autoresponder() simplesmente nao faz nada (atendimento fica
# 100% manual, sem erro).
AI_SERVICE_URL=http://localhost:8004

# Chave secreta COMPARTILHADA E FIXA (nao e token de uso unico de usuario)
# configurada tambem do lado da Evolution API, usada pra autenticar o
# POST /webhook/evolution — comparada via header X-Webhook-Secret.
WEBHOOK_SECRET=troque-por-um-valor-aleatorio-longo

# Evolution API (self-hosted, Baileys)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-pela-chave-da-sua-instancia-evolution

# URL publica deste proprio servico, usada pra configurar o webhook da
# instancia na Evolution API. Se nao setado, deriva da propria requisicao
# (funciona em dev local, mas em producao atras de proxy/gateway configure
# explicitamente).
WEBHOOK_BASE_URL=http://localhost:8003

ALLOWED_ORIGINS=http://localhost:3000
